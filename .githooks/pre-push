#!/bin/sh

echo "Running ruff check..."
uv run ruff check .

if [ $? -ne 0 ]; then
    echo "Ruff check failed. Push blocked."
    exit 1
fi

echo "Running ruff format check..."
uv run ruff format --check .

if [ $? -ne 0 ]; then
    echo "Ruff format check failed. Run 'uv run ruff format .' to fix. Push blocked."
    exit 1
fi

echo "Running tests before push..."
uv run pytest tests/

if [ $? -ne 0 ]; then
    echo "Tests failed. Push blocked."
    exit 1
fi

exit 0
